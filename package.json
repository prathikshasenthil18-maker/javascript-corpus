{
  "name": "granite-mill",
  "version": "1.0.0",
  "description": "GraniteMill -- Community garden plots (TS_V20_VITE_NPM_MONO)",
  "private": true,
  "main": "src/index.ts",
  "engines": {
    "node": ">=20.20.2",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "build": "vite build",
    "test": "mocha",
    "lint": "eslint .",
    "lint:oxlint": "oxlint .",
    "coverage": "nyc npm test",
    "duplication": "jscpd .",
    "mutation": "stryker run",
