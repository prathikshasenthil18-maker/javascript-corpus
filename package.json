    "audit": "npm audit --json",
    "test:vitest": "vitest run",
    "test:vitest:coverage": "vitest run --coverage",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0"
  },
  "optionalDependencies": {
    "@dodona/dolos": "^2.9.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/mocha-runner": "^9.6.1",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "cognitive-complexity-ts": "^0.8.2",
    "cyclomatic-complexity": "^1.2.5",
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-scope": "^9.1.2",
    "espree": "^10.2.0",
    "fast-check": "4.10.2",
    "gutcheck": "^0.10.0",
    "jscpd": "^5.2.1",
    "knip": "^6.36.0",
    "mocha": "^12.0.1",
    "monocart-coverage-reports": "^2.13.0",
    "nyc": "^18.0.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.71.0",
    "vite": "^5.4.0",
    "@vitest/coverage-v8": "2.1.9",
    "vitest": "2.1.9"
  },
  "packageManager": "npm@10.8.2"
